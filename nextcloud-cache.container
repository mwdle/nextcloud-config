[Container]
Image=docker.io/library/redis:8.12.0-alpine3.23@sha256:5af80107c1eeecb484a2269b80a26d12bfa6521787da4663bd9f19f60a163483
ContainerName=nextcloud-cache

Network=nextcloud-cache.network

Timezone=local

ReadOnly=true
ReadOnlyTmpfs=false

User=redis
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Exec=redis-server --save "" --maxmemory 192mb

HealthCmd=redis-cli ping
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=100

[Service]
CPUQuota=25%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
