[Unit]
Requires=nextcloud.service
After=nextcloud.service

[Container]
Image=docker.io/library/nextcloud:35.0.3-apache@sha256:8a7a65b8bae82a79568fec2ed9cf3e374a1944eda2a22ebe130d79463336fee3
ContainerName=nextcloud-cron

Network=nextcloud.network
Network=nextcloud-cache.network
Network=nextcloud-db.network

Timezone=local

Volume=%h/containers/nextcloud/data:/var/www/html:z
Volume=nextcloud-tmp:/tmp:z

ReadOnly=true
ReadOnlyTmpfs=false

User=www-data
UserNS=container:nextcloud
NoNewPrivileges=true
DropCapability=all

Entrypoint=/bin/sh
Exec=-c 'while true; do php -f /var/www/html/cron.php; sleep 300; done'

Memory=128M
PidsLimit=100

[Service]
CPUQuota=50%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
